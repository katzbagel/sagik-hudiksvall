---
// Små ikoner (inline SVG) så att inga externa bibliotek behövs
interface Props { namn: 'tass' | 'plats' | 'kalender' | 'post' | 'telefon' | 'hus' | 'bok' | 'pil' | 'kort'; storlek?: number }
const { namn, storlek = 20 } = Astro.props;
const fylld = namn === 'tass';
---
<svg class="ikon" width={storlek} height={storlek} viewBox="0 0 24 24" aria-hidden="true"
  fill={fylld ? 'currentColor' : 'none'} stroke={fylld ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {namn === 'tass' && <Fragment set:html='<ellipse cx="5.5" cy="10" rx="2" ry="2.6"/><ellipse cx="9.5" cy="5.5" rx="2" ry="2.6"/><ellipse cx="14.5" cy="5.5" rx="2" ry="2.6"/><ellipse cx="18.5" cy="10" rx="2" ry="2.6"/><path d="M12 11.5c-3 0-6.2 4.2-6.2 6.6 0 2.4 2.6 2.6 6.2 1.4 3.6 1.2 6.2 1 6.2-1.4 0-2.4-3.2-6.6-6.2-6.6z"/>' />}
  {namn === 'plats' && <Fragment set:html='<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>' />}
  {namn === 'kalender' && <Fragment set:html='<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' />}
  {namn === 'post' && <Fragment set:html='<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>' />}
  {namn === 'telefon' && <Fragment set:html='<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>' />}
  {namn === 'hus' && <Fragment set:html='<path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"/>' />}
  {namn === 'bok' && <Fragment set:html='<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5V21h16"/>' />}
  {namn === 'pil' && <Fragment set:html='<path d="M5 12h14M13 6l6 6-6 6"/>' />}
  {namn === 'kort' && <Fragment set:html='<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>' />}
</svg>
