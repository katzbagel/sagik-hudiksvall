---
import { render } from 'astro:content';
import Bas from '../layouts/Bas.astro';
import Sidtitel from '../components/Sidtitel.astro';
import Ikon from '../components/Ikon.astro';
import { menySidor, sajt } from '../lib/data';

export async function getStaticPaths() {
  const sidor = await menySidor();
  return sidor.map((sida) => ({ params: { sida: sida.id }, props: { sida } }));
}
const { sida } = Astro.props;
const { Content } = await render(sida);
const s = await sajt();
const bokning = sida.id === 'hundhall' ? s.bokningslank : undefined;
---
<Bas titel={sida.data.seotitel ?? sida.data.title} beskrivning={sida.data.beskrivning ?? sida.data.ingress}>
  <Sidtitel titel={sida.data.title} ingress={sida.data.ingress}>
    {bokning && <p class="sidtitel-knapp"><a class="knapp" href={bokning}><Ikon namn="kalender" storlek={18} /> Boka hallen</a></p>}
  </Sidtitel>
  <div class="inre">
    <article class="prosa kortyta">
      {sida.data.bild && (
        <figure class="sidbild">
          <img src={sida.data.bild} alt={sida.data.bildtext ?? ''} />
          {sida.data.bildtext && <figcaption>{sida.data.bildtext}</figcaption>}
        </figure>
      )}
      <div class="tabellrulla"><Content /></div>
    </article>
  </div>
</Bas>
