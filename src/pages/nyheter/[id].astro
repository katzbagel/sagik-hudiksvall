---
import { render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import Sidtitel from '../../components/Sidtitel.astro';
import { nyheter } from '../../lib/data';
import { datumMedAr } from '../../lib/datum';

export async function getStaticPaths() {
  return (await nyheter()).map((n) => ({ params: { id: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Bas titel={n.data.title} beskrivning={n.data.sammanfattning}>
  <Sidtitel titel={n.data.title} meta={datumMedAr(n.data.datum)} />
  <div class="inre">
    <article class="prosa kortyta">
      {n.data.bild && <figure class="sidbild"><img src={n.data.bild} alt="" /></figure>}
      <Content />
      <p><a class="textlank" href="/nyheter/">← Alla nyheter</a></p>
    </article>
  </div>
</Bas>
