---
import '../styles/global.css';
import Ikon from '../components/Ikon.astro';
import { sajt, menySidor } from '../lib/data';

interface Props { titel?: string; beskrivning?: string; startsida?: boolean }
const { titel, beskrivning, startsida = false } = Astro.props;
const s = await sajt();
const meny = await menySidor();
const sokvag = Astro.url.pathname;
const fullTitel = !titel ? s.namn : startsida ? `${s.namn} – ${titel}` : `${titel} – ${s.namn}`;
const kanonisk = new URL(Astro.url.pathname, Astro.site).href;
// Strukturerad data så att Google förstår vilka vi är och var vi finns
const organisation = startsida ? {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: s.namn,
  description: beskrivning ?? s.slogan,
  sport: 'Agility',
  url: Astro.site?.href,
  email: s.epost,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: s.startbild ? new URL(s.startbild, Astro.site).href : undefined,
  parentOrganization: { '@type': 'SportsOrganization', name: 'Svenska Agilityklubben', url: 'https://agilityklubben.se' },
  location: [
    { '@type': 'Place', name: 'Träningsplanen', address: { '@type': 'PostalAddress', streetAddress: 'Ullsättersvägen 8', postalCode: '824 34', addressLocality: 'Hudiksvall', addressRegion: 'Gävleborgs län', addressCountry: 'SE' } },
    { '@type': 'Place', name: 'Hundhallen', address: { '@type': 'PostalAddress', streetAddress: 'Baldra 10', addressLocality: 'Hudiksvall', addressRegion: 'Gävleborgs län', addressCountry: 'SE' } },
  ],
  sameAs: [s.facebook, s.instagram].filter(Boolean),
} : null;
const lankar = [
  ...meny.map((m) => ({ href: `/${m.id}/`, text: m.data.menytext ?? m.data.title })),
  { href: '/kalender/', text: 'Kalender' },
];
// Kalender före Kontakt
const kontakt = lankar.findIndex((l) => l.href === '/kontakt/');
if (kontakt > -1) lankar.push(lankar.splice(kontakt, 1)[0]);
const ar = new Date().getFullYear();
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitel}</title>
    <meta name="description" content={beskrivning ?? s.slogan} />
    <meta name="theme-color" content="#b7446a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/calendar" title="Kalender" href="/kalender.ics" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={kanonisk} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={s.namn} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:title" content={fullTitel} />
    <meta property="og:description" content={beskrivning ?? s.slogan} />
    {s.startbild && <meta property="og:image" content={new URL(s.startbild, Astro.site).href} />}
    {organisation && <script type="application/ld+json" set:html={JSON.stringify(organisation)} />}
  </head>
  <body>
    <a class="hoppa" href="#innehall">Hoppa till innehållet</a>
    <header class="sidhuvud">
      <div class="inre sidhuvud-rad">
        <a class="logga" href="/">
          <span class="logga-ikon"><Ikon namn="tass" storlek={22} /></span>
          <span class="logga-text">{s.namn}<small>Agility i Hudiksvall</small></span>
        </a>
        <nav class="meny" id="meny" aria-label="Huvudmeny">
          <button class="menyknapp" type="button" aria-expanded="false" aria-controls="menylista">
            <span class="burgare" aria-hidden="true"></span><span>Meny</span>
          </button>
          <ul id="menylista">
            <li><a href="/" aria-current={sokvag === '/' ? 'page' : undefined}>Start</a></li>
            {lankar.map((l) => (
              <li><a href={l.href} aria-current={sokvag.startsWith(l.href) ? 'page' : undefined}>{l.text}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="innehall"><slot /></main>

    <footer class="sidfot">
      <svg class="vag" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 30 C 240 70 480 0 720 22 S 1200 60 1440 20 V60 H0 Z" fill="currentColor"/></svg>
      <div class="sidfot-yta">
        <div class="inre">
          <div class="kolumner">
            <div>
              <p class="sidfot-logga"><Ikon namn="tass" storlek={20} /> {s.namn}</p>
              <p class="svag">{s.slogan}.</p>
              <p class="sociala">
                {s.facebook && <a href={s.facebook}>Facebook</a>}
                {s.instagram && <a href={s.instagram}>Instagram</a>}
              </p>
            </div>
            <div>
              <h2>Kontakt</h2>
              <p><Ikon namn="post" storlek={16} /> <a href={`mailto:${s.epost}`}>{s.epost}</a></p>
              {s.telefon.map((t) => <p><Ikon namn="telefon" storlek={16} /> {t.namn}: <a href={`tel:${t.nummer.replace(/[^0-9+]/g, '')}`}>{t.nummer}</a></p>)}
            </div>
            <div>
              <h2>Betalning</h2>
              {s.betalning.bankgiro && <p>Bankgiro <strong>{s.betalning.bankgiro}</strong></p>}
              {s.betalning.swish && <p>Swish <strong>{s.betalning.swish}</strong></p>}
              {s.betalning.clearing && <p>Clearing <strong>{s.betalning.clearing}</strong>, konto <strong>{s.betalning.konto}</strong></p>}
            </div>
            {s.sponsorer.length > 0 && (
              <div>
                <h2>Samarbeten</h2>
                {s.sponsorer.map((sp) => (
                  <div class="sponsor">
                    {sp.logga && <img src={sp.logga} alt={sp.namn} loading="lazy" />}
                    <p>{sp.lank ? <a href={sp.lank}>{sp.namn}</a> : <strong>{sp.namn}</strong>}</p>
                    {sp.text && <p class="svag">{sp.text}</p>}
                  </div>
                ))}
              </div>
            )}
          </div>
          <p class="smatt">© {ar} {s.namn}{s.sedan && ` · ${s.sedan}`}</p>
        </div>
      </div>
    </footer>
    <script>
      // Dölj händelser som redan passerat (sidan kan vara byggd för några dagar sedan)
      const idag = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Stockholm' }).format(new Date());
      document.querySelectorAll<HTMLElement>('li.handelse[data-slut]').forEach((el) => {
        if ((el.dataset.slut ?? '') < idag) el.hidden = true;
      });
      const nav = document.getElementById('meny');
      const btn = nav?.querySelector('button');
      btn?.addEventListener('click', () => {
        const oppen = nav!.classList.toggle('oppen');
        btn.setAttribute('aria-expanded', String(oppen));
      });
    </script>
  </body>
</html>
